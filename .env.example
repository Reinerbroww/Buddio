# Database configuration
DATABASE_URL=postgresql+psycopg://buddio_user:buddio_password@localhost:5432/buddio_db

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# App settings
APP_ENV=development
SECRET_KEY=some_default_development_secret_key_change_in_production

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true to force rule-based mock AI responses (useful for offline dev)
FORCE_MOCK_AI=false
